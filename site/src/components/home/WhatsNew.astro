---
/** The latest release, straight from the app's own What's New. */
import Icon from '../Icon.astro'
import { version, releaseDate, releaseNotes, changelog, longDate } from '../../data/app'

// The glyph names What's New draws, as the Tabler icons nearest them.
const ICONS: Record<string, string> = {
  chart: 'chart-line', bank: 'building-bank', transfer: 'arrows-left-right', target: 'target',
  wallet: 'wallet', categories: 'category', sparkle: 'sparkles', bell: 'bell', lock: 'lock',
  card: 'credit-card', calendar: 'calendar', gift: 'gift', trophy: 'trophy', coins: 'coins',
}
const TINTS = ['#2D9DFF', '#20C997', '#845EF7', '#FFB347', '#F06595', '#51CF66', '#FF6B6B']
---
<section class="whatsnew py-20 sm:py-28" aria-labelledby="new-title">
  <div class="container-site">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow" data-reveal>What’s new</p>
        <h2 id="new-title" class="h-section mt-4" data-reveal style="--d:60ms">Version {version}</h2>
        <p class="mt-3 text-muted" data-reveal style="--d:100ms">
          <time datetime={releaseDate}>{longDate(releaseDate)}</time> · {changelog.length} releases so far
        </p>
      </div>
      <a href="/changelog" class="btn btn-secondary press !min-h-11 !text-[0.9375rem]" data-reveal style="--d:140ms">
        Every release <Icon name="arrow-right" size={17} stroke={2.2} />
      </a>
    </div>
    <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {releaseNotes.map((n, i) => (
        <li class="surface flex gap-4 rounded-[var(--radius-card)] p-5" data-reveal style={`--d:${(i % 3) * 60}ms`}>
          <span class="cat-tile grid size-10 shrink-0 place-items-center rounded-[13px]" style={`--cat:${TINTS[i % TINTS.length]}`}>
            <Icon name={ICONS[n.icon] ?? 'sparkles'} size={20} stroke={1.9} />
          </span>
          <div class="min-w-0">
            <h3 class="font-semibold leading-snug tracking-[-0.01em]">{n.title}</h3>
            <p class="mt-1 text-[0.9375rem] leading-relaxed text-muted">{n.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
