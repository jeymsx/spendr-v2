---
/**
 * Articles as rows on one card, each the question and its one-line answer,
 * the way the app lists them. The search results page draws the same rows
 * from its script, so these styles are global.
 */
import Icon from '../Icon.astro'
import { topic as topicOf, type HelpArticle } from '../../data/help'

interface Props {
  articles: HelpArticle[]
  /** Name each row's topic too, where the list mixes topics. */
  showTopic?: boolean
  class?: string
  [key: string]: unknown
}
const { articles, showTopic = false, class: cls = '', ...rest } = Astro.props
---
<ul class:list={['surface help-list', cls]} {...rest}>
  {articles.map(a => (
    <li>
      <a href={`/help/${a.id}`} class="help-row press press-fade">
        <span class="help-row-text">
          <span class="help-row-title">{a.title}</span>
          <span class="help-row-sum">{a.summary}</span>
          {showTopic && topicOf(a.topic) && <span class="help-row-topic">{topicOf(a.topic)!.title}</span>}
        </span>
        <Icon name="chevron-right" size={18} stroke={2} class="help-row-chev" />
      </a>
    </li>
  ))}
</ul>

<style is:global>
  .help-list { border-radius: var(--radius-card); padding: 6px; }
  .help-list > li + li { position: relative; }
  .help-list > li + li::before {
    content: ''; position: absolute; left: 16px; right: 16px; top: 0; height: 1px; background: var(--hairline);
  }
  .help-row {
    display: flex; align-items: center; gap: 14px;
    padding: 15px 14px 15px 16px; border-radius: 18px;
  }
  .help-row:hover { background: rgba(15, 23, 42, 0.035); }
  .dark .help-row:hover { background: rgba(255, 255, 255, 0.035); }
  .help-row-text { display: block; flex: 1; min-width: 0; }
  .help-row-title { display: block; font-weight: 600; font-size: 1.0625rem; line-height: 1.35; letter-spacing: -0.012em; }
  .help-row-title mark { background: none; color: var(--ink); font-weight: 700; }
  .help-row-sum { display: block; margin-top: 3px; font-size: 0.9375rem; line-height: 1.5; color: var(--muted); }
  .help-row-topic {
    display: inline-flex; margin-top: 8px; padding: 2px 9px; border-radius: 999px;
    font-size: 0.75rem; font-weight: 600; color: var(--muted-on-tint); background: rgba(15, 23, 42, 0.05);
  }
  .dark .help-row-topic { background: rgba(255, 255, 255, 0.06); }
  .help-row-chev { flex: none; color: var(--muted); transition: translate 0.3s var(--ease-out), color 0.3s var(--ease-out); }
  .help-row:hover .help-row-chev { translate: 2px 0; color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { .help-row-chev { transition: none; } .help-row:hover .help-row-chev { translate: none; } }
</style>
